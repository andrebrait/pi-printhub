# SPDX-License-Identifier: AGPL-3.0-only
# An IPP-over-USB printer (interface 07/01/04, matched as ipp-usb's own rule does) was plugged in.
ACTION=="add", SUBSYSTEM=="usb", ENV{DEVTYPE}=="usb_device", ENV{ID_USB_INTERFACES}=="*:070104:*", TAG+="systemd", ENV{SYSTEMD_WANTS}+="printhub-printer.service"
